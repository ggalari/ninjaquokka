{
  "name": "ninjaquokka",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "remoteUser": "node",
  "containerEnv": {
    "CODESPACE_NAME": "${localEnv:CODESPACE_NAME}",
    "GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN": "${localEnv:GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN}",
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}",
    "DEEPSEEK_API_KEY": "${localEnv:DEEPSEEK_API_KEY}",
    "OPENROUTER_API_KEY": "${localEnv:OPENROUTER_API_KEY}"
  },
  "onCreateCommand": "bash .devcontainer/setup.sh",
  "waitFor": "onCreateCommand",
  "forwardPorts": [3000, 5173, 5432],
  "portsAttributes": {
    "3000": { "label": "API (Fastify)" },
    "5173": { "label": "Web (Vite)", "onAutoForward": "openBrowser" },
    "5432": { "label": "Postgres", "onAutoForward": "silent" }
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "Prisma.prisma",
        "bradlc.vscode-tailwindcss",
        "ckolkman.vscode-postgres",
        "kilocode.kilo-code"
      ]
    }
  }
}
