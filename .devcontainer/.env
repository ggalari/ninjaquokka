# Development environment — the single place to change these values.
# Docker Compose reads this file automatically (see docker-compose.yml).

# Project-specific database name.
DB_NAME=ninjaquokka

# Dev-only defaults (harmless). Production uses a secret manager instead.
POSTGRES_USER=ninjaquokka
POSTGRES_PASSWORD=ninjaquokka

# Better Auth. The secret must be at least 32 characters.
BETTER_AUTH_SECRET=dev-better-auth-secret-ninjaquokka-0123456789
BETTER_AUTH_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:5173
