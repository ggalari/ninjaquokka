# Host-run environment for an external or self-managed PostgreSQL.
# Scenario 2.1 (host app + Compose DB) does NOT copy this file: it sources
# .devcontainer/.env and assembles DATABASE_URL, so the values stay aligned.
# This literal URL must still match the credentials and database name you use;
# inside the dev container, Compose assembles it from POSTGRES_USER,
# POSTGRES_PASSWORD and DB_NAME (host and port are fixed to localhost:5432).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app
PORT=3000
BETTER_AUTH_SECRET=dev-better-auth-secret-change-me-0123456789
BETTER_AUTH_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:5173

# Optional OIDC identity provider. Set the provider id, discovery URL, and
# client id together to enable SSO. Leave the secret unset for a public/PKCE
# client.
# AUTH_EMAIL_PASSWORD_ENABLED=true
# AUTH_SSO_PROVIDER_ID=keycloak
# AUTH_SSO_DISCOVERY_URL=http://localhost:8080/realms/dev/.well-known/openid-configuration
# AUTH_SSO_CLIENT_ID=fullstack
# AUTH_SSO_CLIENT_SECRET=change-me
# AUTH_SSO_SCOPES=openid,profile,email
# AUTH_SSO_LABEL=Company SSO
